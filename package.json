    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "nuxt-auth-utils": "^0.5.30",
    "openid-client": "^6.8.8"
  },
  "peerDependencies": {
    "nuxt": "^3.17.0 || ^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "24.10.1",
    "eslint": "10.10.0",
    "h3": "1.15.11",
    "jose": "6.2.12",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
