{
  "name": "@softalleys/nuxt-lightning-auth",
  "version": "1.1.0",
  "description": "Nuxt layer implementing the Lightning OIDC relying party: server-side session, tenant API proxy and logout channels.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Softalleys/nuxt-lightning-auth.git"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "composables",
    "middleware",
    "nuxt.config.ts",
    "plugins",
    "server",
    "test/fixtures",
    "types",
    "utils"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
